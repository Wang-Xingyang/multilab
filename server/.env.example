# MultiLab 环境配置
# 复制此文件为 .env 并调整参数: cp .env.example .env
TUTORIALS_DIR=../../tutorials
RUNTIME_STATE_DIR=../.multilab-state
PACKAGE_LIBRARY_DIR=../.multilab-state/packages
PORT=3000
# auto | bind-mount | runtime-internal
# auto bind-mounts on Linux/WSL ext4 and falls back to copy/sync elsewhere.
WORKSPACE_STRATEGY=auto
