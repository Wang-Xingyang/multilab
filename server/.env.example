# MultiLab 环境配置
# 复制此文件为 .env 并调整参数: cp .env.example .env
TUTORIALS_DIR=../../tutorials
RUNTIME_STATE_DIR=../.multilab-state
PACKAGE_LIBRARY_DIR=../.multilab-state/packages
PORT=3000
# auto | bind-mount | copy
# auto bind-mounts on Linux ext4 and copies the current step on Windows.
# runtime-internal is still accepted as an alias for copy.
WORKSPACE_STRATEGY=auto
